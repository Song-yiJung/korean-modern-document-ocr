# API Keys (.env.example → .env로 복사 후 값 입력)

# [STEP 1] Google Cloud Vision API
# 발급 절차: Google Cloud Console → APIs & Services → 사용자 인증 정보
# 다운로드한 JSON 파일의 전체 경로
VISION_KEY_PATH="/path/to/your/vision-key.json"

# [STEP 2] Google Gemini API
# 발급 절차: Google AI Studio (https://aistudio.google.com/app/apikey)
# AIzaSy...로 시작하는 문자열
GEMINI_API_KEY="AIzaSy..."

# [선택] Google Drive 경로
# 로컬 머신에서 실행 시 불필요 (Colab 전용)
# INPUT_DIR="/content/drive/MyDrive/사료_이미지"
# OUTPUT_DIR="/content/drive/MyDrive/vision_결과"

# [선택] 환율 (청구액 환산)
USD_TO_KRW=1400